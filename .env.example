# ============================================================
# ISP Billing System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# ============================================================

# === Database ===
# Async URL for FastAPI (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://billing_user:billing_pass@postgres:5432/billing_db
# Sync URL for Celery workers (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://billing_user:billing_pass@postgres:5432/billing_db

# === Redis ===
# Used by Celery broker/backend and M-Pesa token cache
REDIS_URL=redis://redis:6379/0

# === JWT Authentication ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Encryption ===
# Fernet key for encrypting router passwords in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate-with-python-cryptography-fernet

# === Safaricom M-Pesa Daraja API ===
# Environment: 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox
# Consumer Key & Secret from Daraja developer portal
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Paybill or Till Number
MPESA_BUSINESS_SHORTCODE=174379
# Passkey from Daraja portal (sandbox default provided)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public HTTPS URL where Safaricom can reach your callbacks
# Must NOT contain 'mpesa', 'm-pesa', or 'safaricom' in the path
MPESA_CALLBACK_BASE_URL=https://your-public-domain.com

# === Africa's Talking SMS ===
# Use 'sandbox' for testing, your app username for production
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
# Optional: registered alphanumeric sender ID (leave empty for default)
AT_SENDER_ID=

# === Default Admin Account ===
# Created automatically on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@example.com
